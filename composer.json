{
    "name": "koshuang/laravel-hexagonal",
    "description": "Laravel scaffolding for modular Hexagonal Architecture with Ports and Adapters.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/koshuang/laravel-hexagonal",
    "keywords": [
        "laravel",
        "hexagonal-architecture",
        "clean-architecture",
        "ddd",
        "ports-and-adapters"
    ],
    "authors": [
        {
            "name": "Kos Huang",
            "email": "koshuang@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/koshuang/laravel-hexagonal/issues",
        "source": "https://github.com/koshuang/laravel-hexagonal"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/support": "^13.0",
        "symfony/process": "^7.4|^8.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "larastan/larastan": "^3.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/phpinsights": "^2.14",
        "onramplab/onr-phpcs-laravel": "^1.2",
        "nwidart/laravel-modules": "^13.0",
        "orchestra/testbench": "^11.0",
        "phpmd/phpmd": "^2.15",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-mockery": "^2.0",
        "phpunit/phpunit": "^12.5",
        "rector/rector": "^2.5",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "Koshuang\\LaravelHexagonal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koshuang\\LaravelHexagonal\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        },
        "laravel": {
            "providers": [
                "Koshuang\\LaravelHexagonal\\LaravelHexagonalServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/phpunit"
        ],
        "phpstan": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "phpcs": [
            "@php vendor/bin/phpcs"
        ],
        "phpcs:fix": [
            "@php vendor/bin/phpcbf"
        ],
        "phpmd": [
            "tools/scripts/phpmd.sh src text rulesets.xml"
        ],
        "deptrac": [
            "@php vendor/bin/deptrac analyze --config-file=deptrac.yaml"
        ],
        "insights": [
            "@php vendor/bin/phpinsights --no-interaction"
        ],
        "rector": [
            "@php vendor/bin/rector process --dry-run"
        ],
        "lint": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G",
            "@php vendor/bin/phpcs",
            "tools/scripts/phpmd.sh src text rulesets.xml",
            "@php vendor/bin/deptrac analyze --config-file=deptrac.yaml",
            "@php vendor/bin/phpinsights --no-interaction",
            "@php vendor/bin/rector process --dry-run",
            "@php vendor/bin/phpunit"
        ]
    }
}
