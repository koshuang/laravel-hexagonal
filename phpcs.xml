<?xml version="1.0"?>
<ruleset name="Laravel Hexagonal Standards">
    <description>Code style rules for the Laravel Hexagonal package.</description>

    <rule ref="onr-phpcs-laravel">
        <exclude name="Generic.Debug.ClosureLinter"/>
        <exclude name="Generic.Debug.CSSLint"/>
        <exclude name="Generic.Debug.ESLint"/>
        <exclude name="Generic.Debug.JSHint"/>
        <exclude name="Generic.Formatting.NoSpaceAfterCast"/>
        <exclude name="Generic.Functions.CallTimePassByReference"/>
        <exclude name="MySource.PHP.EvalObjectFactory"/>
    </rule>

    <file>src</file>
    <file>tests</file>
</ruleset>
